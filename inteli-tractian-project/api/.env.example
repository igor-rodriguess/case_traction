GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Defina modelos somente após confirmar sua disponibilidade na conta.
GROQ_MODEL=
GEMINI_MODEL=
CEREBRAS_MODEL=

# Initial role/model selection for the controlled smoke (no credentials here).
GEMINI_UNDERSTANDING_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-3.6-flash
GROQ_INVESTIGATOR_MODEL=openai/gpt-oss-120b
CEREBRAS_REPORTER_MODEL=gpt-oss-120b

# --- Supabase -----------------------------------------------------------------
# Apenas os nomes. Os valores vivem em api/.env, que não é versionado.
#
# SUPABASE_DB_URL e SUPABASE_SECRET_KEY são credenciais de BACKEND:
# nunca vão para o frontend, nunca aparecem numa resposta de API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DB_URL=

# Avaliadores. Provedores distintos reforcam a independencia entre os dois.
JUDGE_A_PROVIDER=
JUDGE_B_PROVIDER=
